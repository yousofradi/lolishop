# Cloudinary Credentials (Required for persistent image storage)
SNAPRENDER_API_KEY=
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server Port
PORT=5000

# MongoDB URI (Example)
# DB_URI=mongodb://localhost:27017/ecommerce

# Redis URL (Upstash Example: rediss://default:PASSWORD@endpoint.upstash.io:6379)
REDIS_URL=

# Admin Credentials & API Key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_API_KEY=loli_secret_admin_key
